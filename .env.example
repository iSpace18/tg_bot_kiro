BOT_TOKEN=your_bot_token_from_botfather
ADMIN_IDS=your_telegram_id
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

VPN_PANEL_URL=https://your-server-ip:2053
VPN_PANEL_USERNAME=admin
VPN_PANEL_PASSWORD=admin

# Set to False for production with real VPN panel
VPN_MOCK_MODE=False

TRIAL_DAYS=3
REFERRAL_BONUS_PERCENT=15

# Optional: YooKassa payment integration
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# Optional: Proxy settings if Telegram is blocked
# PROXY_URL=http://proxy.example.com:8080
# PROXY_URL=socks5://127.0.0.1:1080
